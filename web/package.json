{
  "name": "innsegl-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test -c tests/playwright.config.ts",
    "test:e2e:update": "playwright test -c tests/playwright.config.ts --update-snapshots",
    "tokens": "./src/tokens/check-tokens.sh && ./src/tokens/check-tokens-selftest.sh"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "age-encryption": "0.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "27.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "typescript-compiler-api": "npm:typescript@5.9.3",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
